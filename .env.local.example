# ENV example для local разработки (скопируй в .env.local в корне репозитория)
DB_USER=user
DB_PASSWORD=password
DB_PORT=5432
DB_HOST=localhost

AUTH_DB_NAME=auth_db
PROFILE_DB_NAME=profile_db
WALLET_DB_NAME=wallet_db
TWITCH_DB_NAME=twitch_monitor
OCTOPUS_DB_NAME=octopus_db
FIGHT_DB_NAME=fight_db

# Порты сервисов (application-local.yml читает их из .env.local)
AUTH_SERVER_PORT=8001
AUTH_MONITORING_PORT=10001
TWITCH_SERVER_PORT=8002
TWITCH_MONITORING_PORT=10002
TESTAPI_SERVER_PORT=8003
TESTAPI_MONITORING_PORT=10003
PROFILE_SERVER_PORT=8004
PROFILE_MONITORING_PORT=10004
WALLET_SERVER_PORT=8005
WALLET_MONITORING_PORT=10005
OCTOPUS_SERVER_PORT=8006
OCTOPUS_MONITORING_PORT=10006
FIGHT_SERVER_PORT=8007

# RabbitMQ
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# Kafka
SPRING_KAFKA_PORT=9092

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# App
JWT_SECRET=secret
# Shared secret octopusService uses to authenticate as itself when calling
# wallet's /private/me/game/credits|debits (GameWalletController) - without it
# those endpoints refuse all requests. Any player calling them directly with
# only their own JWT still gets rejected.
WALLET_SERVICE_TOKEN=change_me_wallet_service_secret

# Octopus (опционально; по умолчанию URL собирается из OCTOPUS_SERVER_PORT)
# OCTOPUS_SPRITE_URL_TEMPLATE=http://localhost:8006/api/v1/octopus/images/octopus/%d.png
# OCTOPUS_ITEM_ICON_URL_TEMPLATE=http://localhost:8006/api/v1/octopus/images/items/%d.png
# OCTOPUS_SKILL_ICON_URL_TEMPLATE=http://localhost:8006/api/v1/octopus/images/skills/%d.png
OCTOPUS_GACHA_COST_MINOR=100
OCTOPUS_GACHA_MAX_TEMPLATE_ID=6
OCTOPUS_LOOT_TIER_1_WEIGHT=70
OCTOPUS_LOOT_TIER_2_WEIGHT=30
OCTOPUS_LOOT_COIN_TIER_1=50
OCTOPUS_LOOT_COIN_TIER_2=150

METRICS_USERNAME=prometheus
METRICS_PASSWORD=strong_password

alloy_twitch=fhfghfgh
