# ENV example для local разработки
DB_USER=user
DB_PASSWORD=password
DB_PORT=5432
DB_HOST=localhost

AUTH_DB_NAME=auth_db
PROFILE_DB_NAME=profile_db
WALLET_DB_NAME=wallet_db
TWITCH_DB_NAME=twitch_monitor
OCTOPUS_DB_NAME=octopus_db

# RabbitMQ
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=0000
SPRING_RABBITMQ_USERNAME=name
SPRING_RABBITMQ_PASSWORD=password

# Kafka
SPRING_KAFKA_PORT=port

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=port

# App
#SERVER_PORT=8000
JWT_SECRET=secret
WALLET_BASE_URL=http://localhost:8005
OCTOPUS_GACHA_COST_MINOR=100
OCTOPUS_GACHA_MAX_TEMPLATE_ID=6
OCTOPUS_SPRITE_URL_TEMPLATE=http://localhost:8006/images/octopus/%d.png

#MONITORING_PORT=9000
METRICS_AUTH_USERNAME=prometheus
METRICS_AUTH_PASSWORD=strong_password

